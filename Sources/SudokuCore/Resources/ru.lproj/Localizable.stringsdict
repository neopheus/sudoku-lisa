		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>few</key>
			<string>осталось %d</string>
			<key>many</key>
			<string>осталось %d</string>
			<key>one</key>
			<string>осталась %d</string>
